# ========== LOCAL DEVELOPMENT ==========
# Copy this file to .env and only set the values below for local dev
# Everything else has safe defaults (SQLite, local filesystem, console email, etc)

DJANGO_SECRET_KEY=dev-key-anything-works-for-local-dev
DJANGO_DEBUG=1
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@localhost


# ========== PRODUCTION ON RAILWAY ==========
# Set ONLY these variables in Railway Variables tab (not in this .env file)
# Leave them commented out here—they're documentation only

# Django core
# DJANGO_SECRET_KEY=<generate a new random secure string>
# DJANGO_DEBUG=False

# Host & CORS (set to your actual domain)
# All four are required on the deploying host. Defaults only cover *.railway.app,
# so adding a custom domain without setting these breaks the app.
#
# ALLOWED_HOSTS_STR — checked against the Host header (which domain the request
#   is addressed to). No scheme, no port. Keep ".railway.app" in the list so the
#   Railway-provided URL keeps working. Leading dot = match subdomains.
#   Missing/wrong -> HTTP 400 on every request.
ALLOWED_HOSTS_STR=yourdomain.com,www.yourdomain.com,.railway.app
#
# CSRF_ALLOWED_ORIGINS_STR — checked against the Origin header (which site
#   initiated the request). REQUIRES a scheme, and a port if non-default.
#   Only applies to unsafe methods (POST/PUT/DELETE/PATCH).
#   Missing/wrong -> form submissions fail CSRF validation.
CSRF_ALLOWED_ORIGINS_STR=https://yourdomain.com,https://www.yourdomain.com
#
# CORS_ALLOWED_ORIGINS — browser read/write access. Same format as
#   CSRF_ALLOWED_ORIGINS_STR.
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
#
# FRONTEND_URL — base URL used to build links in emails (verification, password
#   reset). Must be https:// in production or the emailed links are unusable.
FRONTEND_URL=https://yourdomain.com

# Email (Resend API — required for Railway, SMTP blocked on Hobby plan)
# RESEND_API_KEY=<from Resend dashboard>
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Media Storage (Railway Bucket via its S3-compatible API)
# Link a Railway Bucket to the backend service; Railway provides these values.
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_ENDPOINT_URL=<Railway Bucket S3-compatible endpoint>
# AWS_S3_REGION_NAME=<Railway Bucket region>
# AWS_ACCESS_KEY_ID=<bucket access key>
# AWS_SECRET_ACCESS_KEY=<bucket secret key>
# AWS_S3_USE_SSL=true

# Database (auto-set by Railway when you link PostgreSQL—no action needed)
# DATABASE_URL=<auto-set by Railway>

# Cache & rate limiting (Redis — required so rate limits are shared across instances)
# CACHE_URL=<Railway Redis plugin connection string, e.g. redis://default:password@host:port>
# NUM_TRUSTED_PROXIES=1  (only increase if a CDN or extra proxy is added in front of Railway)

# OAuth (optional—only set if using social login)
# GOOGLE_CLIENT_ID=<from Google Cloud Console>


# ========== WHAT NOT TO SET LOCALLY ==========
# These have safe defaults for LOCAL DEVELOPMENT (DEBUG=1) only.
# Several of them (ALLOWED_HOSTS_STR, CSRF_ALLOWED_ORIGINS_STR,
# CORS_ALLOWED_ORIGINS, CACHE_URL) are REQUIRED on the deploying host.
#   - DATABASE_URL (local): defaults to SQLite, Railway auto-sets it
#   - AWS_STORAGE_BUCKET_NAME (local): defaults to local filesystem
#   - ALLOWED_HOSTS_STR (local): DEBUG=1 overrides to allow everything
#   - CSRF_ALLOWED_ORIGINS_STR (local): DEBUG=1 allows all CORS
#   - CORS_ALLOWED_ORIGINS (local): DEBUG=1 allows all origins
#   - EMAIL_BACKEND, EMAIL_HOST, etc. (local): defaults to console output
#   - RESEND_API_KEY (local): not used, console backend handles email
#   - GOOGLE_CLIENT_ID (local): optional, only if testing OAuth
